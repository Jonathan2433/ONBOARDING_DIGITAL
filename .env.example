# =============================================================================
#  eXalt Onboarding Digital — modele de configuration
#  Version 1.1 — LOT 1, sous-etape T7, story MVP-L01-US006
#  (v1.0 en T3, story MVP-L01-US003 — ECART-006 clos)
#  (v0.1 produite au LOT 0, S5, story MVP-L00-US007)
#
#  v1.1 retire le doublon de APP_REVISION, declaree deux fois a l'identique
#  (ECART-022). 77 variables, 77 noms distincts — le compte etait de 78
#  affectations pour 77 noms.
# =============================================================================
#
#  CE FICHIER NE CONTIENT AUCUN SECRET REEL. Il est versionne.
#  Le fichier .env, lui, n'est JAMAIS versionne (cahier des charges 20.3).
#
#  Mode d'emploi :
#      cp .env.example .env
#      puis remplacer chaque valeur CHANGE_ME_* par une valeur reelle
#
#  Trois environnements, trois fichiers distincts, aucune valeur partagee :
#      .env                  -> developpement       (projet onboarding-dev)
#      .env.recette          -> recette             (projet onboarding-recette)
#      .env.prod-local       -> production locale   (projet onboarding-prod-local)
#  Volumes, bases, buckets, secrets, reseaux et ports distincts (cahier 22.2).
#
#  Chaque variable porte :
#      [source]  la decision ou section qui la justifie
#      [lot]     le lot ou elle devient effective
#  Aucune variable n'est presente sans source validee. La liste sera completee
#  au LOT 1 quand les services seront reellement configures (ECART-006).
#
#  Politique complete : docs/operations/politique-configuration-et-secrets.md
# =============================================================================


# -----------------------------------------------------------------------------
#  1. IDENTITE DE L'ENVIRONNEMENT
# -----------------------------------------------------------------------------

# Environnement d'execution. Conditionne les garde-fous de demarrage.
# Valeurs autorisees : development | recette | production
# [source] cahier 22.2   [lot] 1
APP_ENV=development

# Nom du projet Docker Compose. DOIT differer entre les trois environnements.
# Valeurs attendues : onboarding-dev | onboarding-recette | onboarding-prod-local
# [source] cahier 22.2   [lot] 1
COMPOSE_PROJECT_NAME=onboarding-dev

# Version applicative deployee. Doit correspondre au build et etre exposee par
# /health/version. Format vX.Y.Z, jalonne sur les portes (DEC-428).
# [source] cahier 18.7 ; DEC-428   [lot] 1
APP_VERSION=0.0.0-dev

# [source] cahier 18.7 et DEC-445 — empreinte du commit construit.
# Exposee par /health/version et par le label OCI `revision`. **Injectee a la
# construction de l'image depuis T7** (DEC-480) : les Dockerfile de api et
# worker declarent `ARG APP_REVISION` et le gravent en `ENV`. `inconnue` tant
# qu'aucune valeur n'est fournie : afficher 0.0.0 serait affirmer une version
# qu'on ne connait pas.
# [lot] 1
APP_REVISION=inconnue

# URL publique de l'application, servie par Caddy.
# Aucun domaine public n'est necessaire pendant la phase locale (cahier 22.2).
# [source] cahier 15.2, 22.2   [lot] 1
PUBLIC_BASE_URL=https://localhost

# Cle secrete applicative : signature des sessions et des jetons.
# OBLIGATOIRE. Doit etre unique par environnement. Ne jamais reutiliser.
# Generation : openssl rand -base64 48
# [source] cahier 20.3   [lot] 3
APP_SECRET_KEY=CHANGE_ME_GENERER_UNE_CLE_UNIQUE_PAR_ENVIRONNEMENT

# Documentation interactive de l'API. Interdite en production (cahier 18.1).
# [source] cahier 18.1   [lot] 1
API_DOCS_ENABLED=true


# -----------------------------------------------------------------------------
#  2. JOURNALISATION
# -----------------------------------------------------------------------------

# Format des logs. "json" obligatoire : les logs sont structures et correles.
# [source] cahier 28.1 ; MVP-L01-US004   [lot] 1
LOG_FORMAT=json

# Niveau de journalisation. debug | info | warning | error
# [source] cahier 28.1   [lot] 1
LOG_LEVEL=info

# Conservation des logs techniques, en jours. 30 jours valides.
# L'audit fonctionnel a sa propre duree, voir section 8.
# [source] cahier 28.3   [lot] 1
LOG_RETENTION_DAYS=30

# [source] cahier 28.3 — « rotation et limite de taille obligatoires ».
# Le processus ecrit sur stdout ; c'est le pilote de journalisation de Docker qui
# rotate. Ces deux valeurs le configurent dans docker-compose.base.yml.
# LOG_RETENTION_DAYS ci-dessus porte la conservation calendaire, que le pilote
# json-file ne sait pas appliquer : elle releve d'une collecte centralisee au
# LOT 13. Voir QO-113.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Aucune donnee sensible, aucun secret, aucun jeton, aucun magic link complet,
# aucun CSV complet, aucun corps d'e-mail ne doit etre journalise (cahier 28.2).
# Cette regle n'est pas configurable : elle est implementee dans le code.


# -----------------------------------------------------------------------------
#  3. POSTGRESQL — source de verite
# -----------------------------------------------------------------------------
# [source] cahier 15.1, 16.2 ; DATA-011   [lot] 1

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=onboarding_dev
POSTGRES_USER=onboarding_app
POSTGRES_PASSWORD=CHANGE_ME_MOT_DE_PASSE_POSTGRES

# Port expose sur la machine hote. DOIT differer entre les trois environnements.
# PostgreSQL ne doit jamais etre expose publiquement.
# [source] cahier 22.2   [lot] 1
POSTGRES_HOST_PORT=5432

# Aucune creation automatique de table : les migrations Alembic sont explicites.
# [source] cahier 16.2 ; roadmap 2.3   [lot] 2
DB_AUTO_CREATE=false


# -----------------------------------------------------------------------------
#  4. REDIS — transport uniquement
# -----------------------------------------------------------------------------
# Redis ne stocke AUCUNE donnee metier durable. Il peut etre vide sans perte de
# la source de verite (DATA-011, ARB-DATA-005).
# [source] cahier 15.1, 16.4   [lot] 1

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_MOT_DE_PASSE_REDIS
REDIS_HOST_PORT=6379


# -----------------------------------------------------------------------------
#  5. MINIO — stockage objet
# -----------------------------------------------------------------------------
# Les fichiers sont dans MinIO, les metadonnees dans PostgreSQL (DATA-008).
# Aucun Base64 en base, aucun media dans Git (cahier 19.1).
# [source] cahier 15.1, 19.1   [lot] 1

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=CHANGE_ME_UTILISATEUR_MINIO
MINIO_ROOT_PASSWORD=CHANGE_ME_MOT_DE_PASSE_MINIO
MINIO_USE_SSL=false
MINIO_REGION=eu-west-1

# Bucket distinct par environnement (cahier 22.2).
MINIO_BUCKET=onboarding-dev-media
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001


# -----------------------------------------------------------------------------
#  6. E-MAILS
# -----------------------------------------------------------------------------
# Mailpit est EXCLUSIF en developpement ET en recette. Aucun contournement
# n'est autorise en recette (cahier 16.5 ; MVP-L11-US003).
# Valeurs autorisees : mailpit | smtp
# [source] cahier 16.5   [lot] 3

EMAIL_PROVIDER=mailpit

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=no-reply@exalt-company.com
SMTP_FROM_NAME=eXalt Onboarding

# Interface web de Mailpit, developpement et recette uniquement.
# Mailpit ne doit jamais etre expose publiquement.
MAILPIT_HOST_PORT=8025

# En production, EMAIL_PROVIDER=smtp et un fournisseur transactionnel reel est
# obligatoire. Dependance bloquante DEP-004.


# -----------------------------------------------------------------------------
#  7. AUTHENTIFICATION ET SESSIONS
# -----------------------------------------------------------------------------
# Valeurs issues de decisions validees : ne pas modifier sans arbitrage.

# Domaines e-mail autorises, separes par des virgules.
# Domaine initial confirme : exalt-company.com (cahier 7.2). Configurable.
# [source] cahier 7.2 ; modele 5.4   [lot] 3
ALLOWED_EMAIL_DOMAINS=exalt-company.com

# Duree de validite d'un magic link, en minutes. 15 minutes valide.
# Usage unique ; une nouvelle demande invalide la precedente.
# [source] cahier 7.2 ; modele 10.3   [lot] 3
MAGIC_LINK_TTL_MINUTES=15

# Expiration de session sur inactivite, en jours. 7 jours valides.
# [source] cahier 7.4 ; modele 10.4   [lot] 3
SESSION_IDLE_DAYS=7

# Duree absolue maximale d'une session, en jours. 30 jours valides.
# [source] cahier 7.4 ; modele 10.4   [lot] 3
SESSION_ABSOLUTE_DAYS=30

# Cookie de session : HttpOnly, Secure et SameSite obligatoires.
# Aucune donnee d'authentification durable dans localStorage (cahier 7.4).
# [source] cahier 7.4   [lot] 3
SESSION_COOKIE_NAME=exalt_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Protection CSRF des ecritures. Non desactivable.
# [source] cahier 7.4, 20.1 ; MVP-L03-US005   [lot] 3
CSRF_PROTECTION_ENABLED=true


# -----------------------------------------------------------------------------
#  8. SEUILS DE SECURITE
# -----------------------------------------------------------------------------
# Seuils initiaux valides. Modifiables par le super-administrateur uniquement
# (matrice 19). Toute modification est auditee.
# [source] cahier 20.2   [lot] 3

# 5 echecs administrateur en 15 minutes declenchent une alerte.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_MINUTES=15

# 10 demandes de magic link par adresse et par heure : limitation.
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR=10

# 50 demandes depuis une meme origine en une heure : alerte.
MAGIC_LINK_MAX_PER_ORIGIN_PER_HOUR=50

# Plus de 5 exports d'audit en une heure : alerte.
AUDIT_EXPORT_ALERT_PER_HOUR=5

# Toute attribution de super-administrateur et toute purge definitive
# declenchent une alerte. Regle non configurable (cahier 20.2 ; RIGHTS-016).


# -----------------------------------------------------------------------------
#  9. API
# -----------------------------------------------------------------------------
# [source] cahier 18.2   [lot] 1

# Pagination : 25 par defaut, options 25/50/100, maximum 100.
API_PAGE_SIZE_DEFAULT=25
API_PAGE_SIZE_MAX=100

# Prefixe de l'API interne. Aucun acces public externe au MVP (cahier 18.1).
API_PREFIX=/api/v1


# -----------------------------------------------------------------------------
#  10. MEDIAS — limites validees
# -----------------------------------------------------------------------------
# Seuls les medias en etat "ready" sont diffusables (cahier 19.2).
# [source] cahier 19.3 ; modele 16.1   [lot] 11

MEDIA_MAX_PHOTO_MB=10
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_VIDEO_MB=1024
MEDIA_MAX_VIDEO_MINUTES=20

# Cible de poids d'une miniature de trombinoscope, en kilo-octets.
# [source] cahier 25.3   [lot] 5
MEDIA_THUMBNAIL_TARGET_KB=100


# -----------------------------------------------------------------------------
#  11. REGLES METIER PARAMETRABLES
# -----------------------------------------------------------------------------
# Valeurs issues de decisions validees : ne pas modifier sans arbitrage.

# Fenetre d'annulation d'une tache d'onboarding par le nouvel arrivant,
# en minutes. 5 minutes validees (ARB-DROIT-001, RIGHTS-021).
# Au-dela, seuls ESM, administrateur d'entite et super-administrateur peuvent
# reouvrir, avec motif obligatoire et audit.
# [source] cahier 9.4 ; matrice 8.3   [lot] 7
ONBOARDING_TASK_UNDO_MINUTES=5

# Duree d'affichage dans "Ils nous ont rejoints recemment", en mois.
# Un mois apres la date d'arrivee (matrice 7.2 ; modele 12.1).
# [source] cahier 10.5   [lot] 8
RECENT_ARRIVAL_MONTHS=1

# Temporisation de la recherche du trombinoscope, en millisecondes.
# Environ 300 ms valides (cahier 9.3).
# [source] cahier 9.3   [lot] 5
SEARCH_DEBOUNCE_MS=300


# -----------------------------------------------------------------------------
#  12. CONSERVATION ET RGPD
# -----------------------------------------------------------------------------

# Conservation de l'audit fonctionnel, en jours. Un an valide.
# [source] cahier 10.11, 28.3 ; modele 21.1   [lot] 10
AUDIT_RETENTION_DAYS=365

# Archivage maximal apres un depart, en mois, avant anonymisation.
# Trois mois valides (cahier 21.3 ; modele 22.5).
# [source] cahier 21.3   [lot] 11
DEPARTURE_ARCHIVE_MONTHS=3

# Conservation du CSV source apres import, en jours.
# Duree exacte encore ouverte : question QO-100, bloquante avant donnees reelles.
# [source] modele 19.1 ; QO-100   [lot] 9
IMPORT_SOURCE_RETENTION_DAYS=CHANGE_ME_EN_ATTENTE_DE_QO_100


# -----------------------------------------------------------------------------
#  13. WORKER ET TRAITEMENTS ASYNCHRONES
# -----------------------------------------------------------------------------
# Les jobs sont persistes dans PostgreSQL. Redis n'est pas la source de verite.
# [source] cahier 16.4 ; DATA-011, ARB-DATA-005   [lot] 11

# Files validees, dans l'ordre du cahier des charges. Ne pas retirer de file.
DRAMATIQ_QUEUES=default,emails,imports,media,exports,maintenance,security

WORKER_CONCURRENCY=2

# Detection d'un job bloque : sans progression depuis N minutes, alerte error.
# [source] cahier 27.4   [lot] 11
JOB_STALLED_ALERT_MINUTES=30

# Tache sans worker depuis N minutes : alerte error.
# [source] cahier 27.4   [lot] 11
WORKER_ABSENT_ALERT_MINUTES=10


# -----------------------------------------------------------------------------
#  14. SUPERVISION
# -----------------------------------------------------------------------------
# Uptime Kuma est le canal principal. Jonathan est l'unique destinataire pendant
# la phase locale (cahier 27.1 ; matrice 17).
# [source] cahier 27.1, 27.2   [lot] 11

# URL de heartbeat Push. A traiter comme un secret : ne jamais versionner.
UPTIME_KUMA_PUSH_URL=CHANGE_ME_URL_DE_HEARTBEAT_PUSH


# -----------------------------------------------------------------------------
#  15. FRONTEND
# -----------------------------------------------------------------------------
# Seules les variables prefixees VITE_ sont exposees au navigateur.
# NE JAMAIS y placer un secret : leur contenu est public.
# [source] cahier 17.1   [lot] 1

VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0-dev

# APP_REVISION figurait ICI une SECONDE fois, en doublon strictement identique
# a sa declaration de la section 1 — meme commentaire, meme valeur. Retiree en
# T7 au titre de `ECART-022` : dans un fichier de configuration, deux
# declarations d'une meme variable, c'est la DERNIERE qui gagne, en silence, le
# jour ou les deux valeurs divergent. Elle n'a par ailleurs rien a faire dans la
# section frontend : elle n'est pas prefixee VITE_ et n'est pas exposee au
# navigateur.


# -----------------------------------------------------------------------------
#  16. CADDY
# -----------------------------------------------------------------------------
# Ports distincts entre les trois environnements (cahier 22.2).
# [source] cahier 15.2, 22.2   [lot] 1

CADDY_HTTP_HOST_PORT=80
CADDY_HTTPS_HOST_PORT=443


# =============================================================================
#  GARDE-FOUS DE DEMARRAGE
# =============================================================================
#  L'application REFUSE de demarrer lorsque APP_ENV=production et que :
#    - une variable obligatoire est absente ou vaut encore CHANGE_ME_* ;
#    - APP_SECRET_KEY est vide, trop courte, ou identique a un autre
#      environnement ;
#    - EMAIL_PROVIDER=mailpit ;
#    - API_DOCS_ENABLED=true ;
#    - SESSION_COOKIE_SECURE=false ;
#    - CSRF_PROTECTION_ENABLED=false ;
#    - DB_AUTO_CREATE=true.
#
#  Source : cahier des charges 20.3. Implementation au LOT 1.
# =============================================================================
