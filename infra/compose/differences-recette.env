# ============================================================================
#  CALQUE DE DIFFERENCES DE L'ENVIRONNEMENT DE RECETTE
#
#  LOT 1, sous-etape T8, story MVP-L01-US002. Exigence : cahier 22.2.
#
#  CE FICHIER NE SE CHARGE PAS. Il n'est jamais passe a `--env-file`. Il declare
#  les SEULES variables dont la recette differe du developpement, et
#  `make env ENVIRONNEMENT=recette` l'applique par-dessus `.env.example` pour
#  engendrer `.env.recette` — qui, lui, n'est pas versionne (.gitignore L17,
#  verifie par `git check-ignore`).
#
#  POURQUOI UN CALQUE ET NON UN SECOND MODELE COMPLET
#
#    Un `.env.recette.example` aurait recopie 77 variables pour n'en changer
#    qu'une quinzaine. Deux modeles de 77 lignes divergent, et la divergence est
#    SILENCIEUSE : c'est exactement ECART-022, ou `.env.example` declarait
#    APP_REVISION deux fois sans que rien ne le signale, et ou le `.env` de la
#    machine comptait quatre variables de moins que le modele pendant deux
#    sous-etapes. Le meme raisonnement a produit DEC-466 pour le masquage : un
#    seul exemplaire d'une regle, pas deux copies a maintenir.
#
#    Consequence utile : toute variable ajoutee a `.env.example` arrive dans la
#    recette sans qu'on y pense, et `make env-check` verifie les DEUX fichiers.
#
#  AUCUN SECRET ICI, ET CE N'EST PAS UN OUBLI. Les cinq valeurs sensibles —
#  APP_SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD, MINIO_ROOT_PASSWORD et
#  MINIO_ROOT_USER — sont ENGENDREES a la creation de `.env.recette`, donc
#  distinctes de celles du developpement par construction. Les ecrire ici les
#  versionnerait, et rendrait les deux environnements identiques sur la
#  cinquieme separation du cahier.
#
#  LES SEPT SEPARATIONS DU CAHIER 22.2, ET OU CHACUNE EST OBTENUE
#
#    1. projet Docker      COMPOSE_PROJECT_NAME, ci-dessous
#    2. base PostgreSQL    POSTGRES_DB, ci-dessous
#    3. bucket MinIO       MINIO_BUCKET, ci-dessous
#    4. volumes            AUTOMATIQUE : Compose prefixe du nom de projet
#    5. secrets            ENGENDRES a la creation, jamais ici
#    6. reseau             AUTOMATIQUE : ${COMPOSE_PROJECT_NAME}-net
#    7. ports              les sept publications, ci-dessous
#
#  La fiche du lot 3 n'en enumere que six : « projet Docker distinct » y manque.
#  C'est ECART-023, de la meme classe que ECART-018. Les sept sont comptees sur
#  le cahier, pas sur la fiche, et `make separations-check` les verifie une par
#  une sur l'etat REEL des deux environnements.
# ============================================================================

# ----------------------------------------------------------------------------
#  Identite de l'environnement
#
#  APP_ENV=recette est deja une valeur ACCEPTEE par l'API depuis T3 :
#  settings.py declare `Environnement = Literal["development", "recette",
#  "production"]`. Rien a changer cote code — verifie, non suppose.
#
#  Consequence a connaitre : les sept garde-fous du cahier 20.3 propres a
#  `APP_ENV=production` ne s'appliquent donc PAS a la recette. Les quatre
#  garde-fous universels, eux, s'appliquent — dont le refus de demarrer sur un
#  CHANGE_ME residuel parmi les variables que l'API declare.
# ----------------------------------------------------------------------------
APP_ENV=recette
VITE_APP_ENV=recette

# ----------------------------------------------------------------------------
#  IDENTITE DU BUILD RECETTE — et pourquoi elle doit etre declaree ICI
#
#  Les images publiees portent DEJA leur version et leur revision gravees
#  (DEC-480, ARG -> ENV dans le Dockerfile). On pourrait croire qu'il suffit de
#  laisser l'image parler. MESURE DU 29/07/2026 : c'est FAUX.
#
#    Une surcouche Compose qui declare `APP_VERSION:` a valeur NULLE ne retire
#    PAS la valeur heritee du fichier de base. Eprouve sur un conteneur jetable :
#    `docker compose config` rend toujours la valeur du --env-file, et `run env`
#    la montre bien dans le conteneur. La valeur du fichier d'environnement GAGNE
#    donc sur l'ENV grave dans l'image, toujours.
#
#  Consequence si ces deux lignes manquaient : `/health/version` de la recette
#  annoncerait `0.0.0-dev` / `inconnue` pour une image qui connait parfaitement
#  son identite. Ce serait un mensonge sur l'endpoint dont c'est precisement le
#  role, et le critere de MVP-L01-US003 — « la version correspond au build » —
#  serait contredit sans que rien n'echoue. Meme classe que le defaut T7-8, ou
#  Compose substituait une chaine vide a APP_REVISION.
#
#  VALEURS RELEVEES, NON INVENTEES. Elles decrivent le build epingle par
#  `docker-compose.recette.yml`, publie par l'execution 30458611741 sur le commit
#  3d4080a de `develop`. Source : l'etape « identite » du workflow, qui imprime
#  « version='0.0.0-dev' revision='3d4080a' ». La revision courte est confirmee
#  independamment par `git rev-parse --short 3d4080a55c9d...` -> 3d4080a.
#
#  `0.0.0-dev` n'est pas un defaut oublie : DEC-428 jalonne les versions sur les
#  PORTES et les pose en TAGS. Sur `develop` il n'existe aucune version, et le
#  workflow publie honnetement `0.0.0-dev`. C'est le defaut T7-10 : la valeur
#  injectee EST le resultat correct.
#
#  ELLES VIEILLISSENT AVEC LES EMPREINTES, ET ENSEMBLE. Les rafraichir
#  temporairement : `make images-pin`, qui les derive de la derniere publication
#  reussie et les ecrit dans `.env.recette`. Les figer durablement : un commit.
#  `make separations-check` compare ce que le conteneur RAPPORTE a ce que l'image
#  a GRAVE — les deux cotes sont derives, aucun n'est code en dur.
# ----------------------------------------------------------------------------
APP_VERSION=0.0.0-dev
APP_REVISION=3d4080a

# ----------------------------------------------------------------------------
#  SEPARATION 1 sur 7 — projet Docker distinct
#
#  C'est la separation que la fiche omettait, et c'est aussi celle qui PRODUIT
#  les separations 4 et 6 : Compose prefixe volumes et reseau du nom de projet.
#  Les exemples du cahier 22.2 nomment litteralement `onboarding-recette`.
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=onboarding-recette

# ----------------------------------------------------------------------------
#  SEPARATION 2 sur 7 — base PostgreSQL distincte
#
#  Les deux environnements ont chacun leur INSTANCE PostgreSQL, dans leur propre
#  volume : le nom de base distinct n'est donc pas ce qui separe les donnees, il
#  rend la separation LISIBLE et attrapable. `make separations-check` ne se
#  contente pas de comparer cette variable : il lit `current_database()` DANS
#  chaque instance, parce qu'une variable declaree n'est pas une base servie.
# ----------------------------------------------------------------------------
POSTGRES_DB=onboarding_recette

# ----------------------------------------------------------------------------
#  MOINDRE PRIVILEGE — LOT 3, T1, QO-116, DEC-518
#
#  Des NOMS distincts, pour la meme raison que POSTGRES_DB : les deux
#  environnements ont chacun leur INSTANCE PostgreSQL, dans son propre volume,
#  donc des noms identiques ne creeraient aucune confusion technique. Mais un nom
#  distinct rend la separation LISIBLE dans un journal ou une trace, et c'est ce
#  qui evite qu'on prenne un environnement pour l'autre.
#
#  LES MOTS DE PASSE NE SONT PAS ICI, et ce n'est pas un oubli : ils sont
#  ENGENDRES a la creation de `.env.recette`, donc distincts de ceux du
#  developpement par construction. Les ecrire ici les versionnerait et rendrait
#  les deux environnements identiques sur la cinquieme separation du cahier 22.2.
# ----------------------------------------------------------------------------
POSTGRES_MIGRATIONS_USER=onboarding_recette_migrations
POSTGRES_RUNTIME_USER=onboarding_recette_runtime

# ----------------------------------------------------------------------------
#  SEPARATION 3 sur 7 — bucket MinIO distinct
#
#  Meme remarque : le controle verifie en plus que le bucket du developpement
#  est ABSENT du MinIO de recette, et reciproquement. Deux noms differents ne
#  prouveraient rien si les deux services partageaient un volume.
# ----------------------------------------------------------------------------
MINIO_BUCKET=onboarding-recette-media

# ----------------------------------------------------------------------------
#  SEPARATION 7 sur 7 — les sept publications de ports, distinctes
#
#  Toutes restent liees a 127.0.0.1 par la surcouche Compose : `make ports`
#  echoue sinon, et il compare les publications DECLAREES aux REELLES.
#
#  Bande choisie a l'ecart de celle du developpement, et LIBRE au moment de
#  l'ecriture — mesure du 29/07/2026 par `lsof -nP -iTCP -sTCP:LISTEN` :
#  8080, 8443, 15432, 16379, 19000, 19001 et 18025 n'etaient pris par rien.
#  Le developpement occupait 80, 443, 5432, 6379, 9000, 9001 et 8025.
#
#  Les deux bandes sont DISJOINTES, et c'est la condition pour que les deux
#  stacks puissent tourner en meme temps — ce que QO-085 demande de mesurer.
#  Attention : mesurer la simultaneite ne l'autorise pas. DEC-440 n'admet qu'un
#  environnement a la fois, et T8 prouve la SEPARATION par demarrages successifs.
# ----------------------------------------------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MAILPIT_HOST_PORT=18025
CADDY_HTTP_HOST_PORT=8080
CADDY_HTTPS_HOST_PORT=8443

# ----------------------------------------------------------------------------
#  Hotes servis par Caddy
#
#  Un SEUL Caddyfile sert les deux environnements : il porte
#  `{$CADDY_SITE_APP:app.onboarding.localhost}`, et le service `caddy` transmet
#  ces deux variables au processus. Le dupliquer aurait duplique le mandatement
#  de meme origine de DEC-470, donc une regle de securite.
#
#  DES HOTES DISTINCTS, ET PAS SEULEMENT DES PORTS DISTINCTS. Motif : un port
#  ne se voit pas dans un onglet de navigateur, un nom d'hote si. Deux
#  environnements que rien ne distingue a l'ecran finissent par etre confondus,
#  et le jour ou l'un porte des donnees et l'autre pas, la confusion coute cher.
#
#  Resolution MESUREE le 29/07/2026 : `app.recette.onboarding.localhost` et
#  `api.recette.onboarding.localhost` resolvent en 127.0.0.1 sans toucher a
#  /etc/hosts, comme les hotes du developpement. macOS resout les sous-domaines
#  profonds de .localhost. ATTENTION : Linux ne le fait pas — si un jour un
#  controle de recette tourne en integration continue, il lui faudra les deux
#  lignes de /etc/hosts que ci.yml pose deja pour le developpement.
# ----------------------------------------------------------------------------
CADDY_SITE_APP=app.recette.onboarding.localhost
CADDY_SITE_API=api.recette.onboarding.localhost

# ----------------------------------------------------------------------------
#  Origine publique de l'environnement
#
#  Le port y figure parce qu'il n'est pas 443 : une URL sans port ne joindrait
#  pas cette stack. C'est aussi la valeur que lirait le garde-fou de production
#  du cahier 20.3 — sans effet ici, APP_ENV valant `recette`.
# ----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://app.recette.onboarding.localhost:8443
