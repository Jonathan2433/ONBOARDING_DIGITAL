# Caddyfile — eXalt Onboarding Digital, environnement local
#
# LOT 1, sous-etape T2, story MVP-L01-US002. Decision DEC-446.
#
# HTTPS local par autorite interne. Motifs :
#   - le cahier des charges 22.2 pose qu'aucun domaine public n'est necessaire
#     pendant la phase locale ;
#   - macOS resout *.localhost vers 127.0.0.1 sans modifier /etc/hosts ;
#   - motif determinant : les cookies Secure et SameSite du LOT 3 ne peuvent
#     pas etre eprouves en HTTP clair. Les decouvrir apres la porte G1 serait
#     le scenario de reouverture que signale ROAD-RSK-002.
#
# La racine de l'autorite interne doit etre approuvee UNE FOIS dans le
# trousseau macOS. C'est une action de Jonathan : elle demande son mot de
# passe, l'agent ne la fait pas a sa place.
#
# ETAT A T5 : les deux services ecoutent. La page de statut est servie sur
# app.onboarding.localhost, et l'API sur api.onboarding.localhost.

{
	# Autorite de certification interne, aucune dependance externe.
	local_certs

	# API d'administration, sur la boucle locale du conteneur uniquement.
	# Elle sert au healthcheck : interroger l'API d'administration est un
	# controle qui echoue reellement si Caddy est mal configure.
	admin localhost:2019

	# Journalisation JSON. Le format est impose par le cahier 28.1 ; la
	# correlation applicative arrive en T4.
	log {
		format json
	}
}

app.onboarding.localhost {
	tls internal

	# DEC-470 — LA PAGE ET L'API PARTAGENT UNE SEULE ORIGINE.
	#
	# La page est servie ici, l'API vit sur api.onboarding.localhost : ce sont
	# deux origines distinctes pour un navigateur. Trois montages etaient
	# possibles, et celui-ci est retenu :
	#
	#   - CORS sur l'API : ajoute une surface de securite permanente, et
	#     compliquerait les cookies Secure et SameSite du LOT 3 — or c'est
	#     precisement pour pouvoir les eprouver que DEC-446 impose HTTPS local ;
	#   - renvoi par le serveur de developpement Vite : disparait des qu'une
	#     image de production sert un artefact statique, donc a refaire en T7 ;
	#   - mandatement par Caddy, ici : le navigateur ne voit qu'une origine,
	#     l'API n'est pas modifiee, l'en-tete X-Request-ID reste lisible par la
	#     page sans Access-Control-Expose-Headers, et le montage survit a la
	#     recette comme a la production.
	#
	# Les blocs `handle` sont mutuellement exclusifs : le premier qui correspond
	# traite la requete. L'ordre compte donc, et le fourre-tout vient en dernier.

	# Endpoints d'exploitation, volontairement hors du prefixe versionne
	# (DEC-465).
	handle /health/* {
		reverse_proxy api:8000
	}

	# Contrat versionne. Vide au LOT 1, son contenu arrive au LOT 2.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Tout le reste : la page et ses ressources.
	handle {
		reverse_proxy web:5173
	}
}

api.onboarding.localhost {
	tls internal
	reverse_proxy api:8000
}
